# Copy to .env on the server and fill in. Never commit .env.

# Public hostname pointing at the VM, e.g. everyday-home.duckdns.org
API_DOMAIN=

POSTGRES_DB=everyday
POSTGRES_USER=everyday
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# One-time code the first phone needs to create the household. Generate with: openssl rand -hex 8
# Clear it once the household exists.
SETUP_TOKEN=
