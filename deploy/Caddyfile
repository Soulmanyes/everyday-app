# Caddy obtains and renews a Let's Encrypt certificate for each domain automatically.
# API_DOMAIN and OLD_DOMAIN must resolve to the VM's public IP (DuckDNS subdomains).

(site) {
	encode gzip

	# Caps request bodies so nobody can make the API read a huge one into memory. A phone's biggest request is
	# a sync after a long time offline, far below this.
	request_body {
		max_size 2MB
	}

	# The app's download page and the release APK (published with deploy/publish-release.sh).
	redir /download /download/
	handle /download/* {
		root * /srv
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header Cache-Control "no-cache"
		file_server
	}

	# The page listing all the apps to download, and each app's own page (Gesture Cam is published
	# with publish.sh in its own repo).
	redir /apps /apps/
	handle /apps/* {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy api:8080
	}
}

{$API_DOMAIN} {
	redir / /apps/
	import site
}

# The old address (everyday-home.duckdns.org). Pages people open in a browser move to API_DOMAIN, so
# new links use the new address. The API, version.json and the APK keep answering here without a
# redirect: phones that joined before the move sync with this address, and a redirect can turn their
# POSTs into GETs.
{$OLD_DOMAIN} {
	@pages path / /download /download/ /download/index.html /download/join.html /apps /apps/*
	redir @pages https://{$API_DOMAIN}{uri} permanent
	import site
}

# The owner's screenshot links (its own DuckDNS name, in SHOTS_DOMAIN in .env). Images are uploaded over
# SSH into SHOTS_DIR on the VM, never over HTTP, so this site only reads. Names are long random IDs and
# nothing lists the folder, so a link can't be guessed. Unset, the site falls back to a local-only name
# that needs no certificate.
{$SHOTS_DOMAIN:shots.localhost} {
	@image path_regexp ^/[A-Za-z0-9]{12,}\.(png|jpg|webp|gif)$
	handle @image {
		root * /srv/shots
		header X-Content-Type-Options nosniff
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		respond 404
	}
}
