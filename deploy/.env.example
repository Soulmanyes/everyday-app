# Copy to .env on the server and fill in. Never commit .env.

# Public hostname pointing at the VM, e.g. szekbal.duckdns.org
API_DOMAIN=
# The previous hostname (everyday-home.duckdns.org): its pages redirect to API_DOMAIN, its API keeps working.
OLD_DOMAIN=

POSTGRES_DB=everyday
POSTGRES_USER=everyday
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# One-time code the first phone needs to create the household. Generate with: openssl rand -hex 8
# Clear it once the household exists.
SETUP_TOKEN=

# Firebase service-account key for instant updates (FCM). Defaults to ~/secrets/firebase-service-account.json.
# Keep it outside ~/everyday-app, mode 644 inside a mode 700 folder. Never commit it.
# FCM_KEY_FILE=/home/opc/secrets/firebase-service-account.json
